<?xml version="1.0"?>
<VerticalStack>
	<TextBox Text="{²../shape.Path}"/>
	<Container Background="Navy" Height="100" Width="100">	
		<Shape  Height="20" Width="10" Name="shape" Foreground="White" Size="11,11" Path="M 5.5,1.5 L 9.5,3.5 L 9.5,9.5 L 1.5,9.5 L 1.5,3.5 Z G" Scaled="true" KeepProportions="false"  StrokeWidth="2"/>
	</Container>
	<Container Background="Navy" Height="100" Width="100">	
		<Shape  Height="Fit" Width="Fit" Foreground="White"  Size="11,11" Path="{²../../shape.Path}" Scaled="false" KeepProportions="false"  StrokeWidth="2"/>
	</Container>
</VerticalStack>