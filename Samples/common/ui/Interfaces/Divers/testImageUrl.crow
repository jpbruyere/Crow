	<Image  Width="32" Height="32" Background="vgradient|0:SkyBlue|1:White" Path="url:https://api.nuget.org/v3-flatcontainer/leaf.xnet/5.2.10/icon"/>
	<Label Text="{../img.Path}" Foreground="RebeccaPurple"/>
</VerticalStack>